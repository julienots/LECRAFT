{
  "name": "lecraft",
  "private": true,
  "version": "2.20.0",
  "description": "LeCraft - jeu sandbox voxel 3D hors ligne pour Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "node scripts/e2e.mjs",
    "assets:android": "node scripts/gen-android-assets.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew assembleRelease bundleRelease",
    "e2e:gameplay": "node scripts/e2e-gameplay.mjs",
    "e2e:vanilla": "node scripts/e2e-vanilla.mjs",
    "e2e:addons": "node scripts/e2e-addons.mjs",
    "perf": "node scripts/perf.mjs",
    "screens": "node scripts/screens.mjs",
    "tour": "node scripts/tour.mjs",
    "pack:embed": "node scripts/embed-pack.mjs",
    "e2e:controls": "node scripts/e2e-controls.mjs",
    "e2e:nether": "node scripts/e2e-nether.mjs",
    "e2e:mobs": "node scripts/e2e-mobs.mjs",
    "e2e:movement": "node scripts/e2e-movement.mjs",
    "e2e:end": "node scripts/e2e-end.mjs",
    "e2e:wither": "node scripts/e2e-wither.mjs",
    "e2e:doors": "node scripts/e2e-doors.mjs",
    "e2e:server": "node scripts/e2e-server.mjs",
    "e2e:smp": "node scripts/e2e-smp.mjs",
    "e2e:multi": "node scripts/e2e-multi.mjs",
    "e2e:paper": "node scripts/e2e-paper.mjs",
    "server": "node server/lecraft-server.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
